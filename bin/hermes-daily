#!/usr/bin/env bash
# Wrapper, damit der Agent nur einen Pfad kennen muss und nichts über venvs wissen.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="$ROOT/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "venv fehlt. Einmalig einrichten:" >&2
  echo "  cd $ROOT && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

exec "$PYTHON" "$ROOT/hermes_daily.py" "$@"

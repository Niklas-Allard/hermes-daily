# hermes-daily — Konfiguration
# Kopieren nach .env und ausfüllen:  cp .env.example .env
# Alles, was leer bleibt, schaltet das jeweilige Modul still ab.
#
# WICHTIG: Kommentare immer in eine eigene Zeile schreiben.
# Bei einem leeren Wert würde "KEY=   # Kommentar" den Kommentar als Wert setzen.

# ---------------------------------------------------------------- global ---
# compact | normal | full
HERMES_VERBOSITY=compact
# Sekunden pro Modul
HERMES_TIMEOUT=12
# Harte Obergrenze der Ausgabe, 0 = kein Limit
HERMES_MAX_CHARS=0

# ----------------------------------------------------------- Module an/aus ---
ENABLE_WEATHER=true
# Pollen, UV, Feinstaub — nur für Allergiker sinnvoll
ENABLE_AIR_QUALITY=false
ENABLE_UNTIS=true
ENABLE_CALENDAR=true
ENABLE_NEWS=false
ENABLE_TASKS=true
ENABLE_TRANSIT=true
# Kleidungs- und Packempfehlung
ENABLE_ADVICE=true
# Verlaufs-Log + Stundenplan-Diff
ENABLE_HISTORY=true
HISTORY_KEEP_DAYS=60

# ---------------------------------------------------------------- Wetter ---
# Werte ermitteln:  ./bin/hermes-daily --geocode "Stuttgart"
WEATHER_LAT=
WEATHER_LON=
WEATHER_LOCATION_NAME=
WEATHER_TZ=Europe/Berlin
# Fenster für "Regen ab X Uhr"
WEATHER_DAY_START=7
WEATHER_DAY_END=18

# -------------------------------------------------------------- WebUntis ---
# Server und Schulname ermitteln:  ./bin/hermes-daily --untis-discover "Schulname"
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USERNAME=
UNTIS_PASSWORD=
# Klausuren-Countdown in Tagen, 0 = aus
UNTIS_EXAM_LOOKAHEAD_DAYS=14
# Hausaufgaben und Tagesnachrichten laufen über nicht offiziell dokumentierte
# REST-Endpunkte, die es nicht auf jedem Untis-Server gibt. Liefert einer davon
# bei dir dauerhaft nichts, schalte ihn ab — er kostet sonst nur Wartezeit.
UNTIS_FETCH_HOMEWORK=true
UNTIS_FETCH_MESSAGES=true

# -------------------------------------------------------------- Kalender ---
# Beliebig viele ICS-URLs, kommagetrennt.
# Google/Nextcloud/Apple: Kalender "per Link teilen" -> iCal-Adresse
CALENDAR_ICS_URLS=
# Alternativ oder zusätzlich ein CalDAV-Server
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Leer = alle Kalender, sonst Namen kommagetrennt
CALDAV_CALENDARS=

# ------------------------------------------------------------ Nachrichten ---
NEWS_FEEDS=https://www.tagesschau.de/xml/rss2/
NEWS_MAX_PER_FEED=3
NEWS_MAX_AGE_HOURS=24

# --------------------------------------------------------------- Aufgaben ---
# Markdown-Datei mit "- [ ] Aufgabe"
# Optionale Fälligkeit:  - [ ] Referat abgeben @2026-09-10
TASKS_FILE=~/todo.md
# Nur Aufgaben zeigen, die in N Tagen fällig sind (undatierte immer)
TASKS_HORIZON_DAYS=7
TASKS_MAX=10

# ------------------------------------------------------------------ ÖPNV ---
# dbf        = dbf.finalrewind.org, bundesweit für DB-Stationen (S-Bahn, RE, IC),
#              braucht nur TRANSIT_STATION
# hafas_rest = transport.rest-Instanz, deckt auch Bus/Tram ab, braucht TRANSIT_STOP_ID.
#              v6.db.transport.rest ist derzeit abgeschaltet, v6.bvg/v6.vbb laufen.
TRANSIT_PROVIDER=dbf
# Für dbf, z. B. "Stuttgart Hbf"
TRANSIT_STATION=
TRANSIT_API_BASE=https://v6.db.transport.rest
# Für hafas_rest, ermitteln mit  ./bin/hermes-daily --transit-search "Haltestelle"
TRANSIT_STOP_ID=
# Nur diese Richtungen bzw. Linien, kommagetrennt
TRANSIT_FILTER_DEST=
TRANSIT_FILTER_LINE=
TRANSIT_MAX=5
# Wie weit in die Zukunft geschaut wird
TRANSIT_WINDOW_MIN=60

# ---------------------------------------------------------------- Advice ---
# Bei true: Hinweis auf Allergiemittel bei hohem Pollenflug
ADVICE_ALLERGY=false
ADVICE_SUBJECT_HINTS=Sport=Sportsachen,Schwimmen=Badesachen
